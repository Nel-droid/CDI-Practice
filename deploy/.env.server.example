# CDI Practice — SERVER runtime env (goes in the repo root as `.env` on EC2).
# Fill these in directly over SSH on the instance. chmod 600 .env. Never commit.
# These are the SERVER-SIDE secrets only — the browser never sees them.

# Supabase (unchanged from Vercel)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The anon key + URL are also read as fallbacks by the auth check:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini (server-side only)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash   # optional override

# Paddle (billing) — webhook secret is server-side; price IDs let the webhook
# map a purchase to a tier. Use your LIVE values in production, sandbox while testing.
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_SILVER=
PADDLE_PRICE_GOLD=

# Server
PORT=8080
NODE_ENV=production
