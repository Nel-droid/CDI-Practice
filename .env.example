# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# Supabase project URL (safe to expose in the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key — NEVER send this to the browser.
# Use only in Supabase Edge Functions / server-side jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API key for the AI tutor + writing feedback (server-side ONLY —
# no VITE_ prefix, so it is never bundled into the browser). Free key from
# https://aistudio.google.com/app/apikey . Also set this in the Vercel
# project's Environment Variables for production.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: override the model (defaults to gemini-2.0-flash).
# GEMINI_MODEL=gemini-2.0-flash