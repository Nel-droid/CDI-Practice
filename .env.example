# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# Supabase project URL (safe to expose in the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key — NEVER send this to the browser.
# Use only in Supabase Edge Functions / server-side jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
